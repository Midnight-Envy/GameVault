<h1>Edit <%= @game_entry.game.name %></h1>

<% if @game_entry.errors.any? %>
  <div>
    <h2>Unable to update entry:</h2>

    <ul>
      <% @game_entry.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @game_entry do |f| %>
  <div>
    <%= f.label :status %>
    <%= f.select :status, ["Backlog", "Playing", "Completed"] %>
  </div>

  <div>
    <%= f.label :rating %>
    <%= f.number_field :rating, min: 1, max: 10 %>
  </div>

  <div>
    <%= f.label :hours_played %>
    <%= f.number_field :hours_played, min: 0 %>
  </div>

  <div>
    <%= f.label :notes %>
    <%= f.text_area :notes %>
  </div>

  <%= f.submit "Update Entry" %>
<% end %>

<%= link_to "Back to My Vault", game_entries_path %>