<h1>My GameVault</h1>

<% @game_entries.each do |entry| %>
  <div>
    <h2><%= entry.game.name %></h2>

    <p>Status: <%= entry.status %></p>
    <p>Rating: <%= entry.rating %></p>
    <p>Hours Played: <%= entry.hours_played %></p>
    <p>Notes: <%= entry.notes %></p>

    <%= link_to "Edit", edit_game_entry_path(entry) %>

    <%= button_to "Remove from Vault",
              game_entry_path(entry),
              method: :delete %>
  </div>
<% end %>

<%= link_to "Browse Games", games_path %>