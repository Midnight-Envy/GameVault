<div class="content-container">
  <p class="eyebrow">PROFILE</p>

  <h1>Welcome, <%= @user.username %>!</h1>

  <div class="content-card">
    <h2>Account</h2>

    <p>
      <strong>Email:</strong>
      <%= @user.email %>
    </p>
  </div>

  <div class="content-actions">
    <%= link_to "My Vault", game_entries_path, class: "primary-button" %>
    <%= link_to "Browse Games", games_path, class: "secondary-button" %>
  </div>
</div>