<div class="content-container">
  <h1>Review <%= @game.name %></h1>

  <%= form_with model: [@game, @review] do |f| %>
    <% if @review.errors.any? %>
      <div class="error-messages">
        <h2>Unable to submit review:</h2>

        <ul>
          <% @review.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :title %>
      <%= f.text_field :title %>
    </div>

    <div>
      <%= f.label :body %>
      <%= f.text_area :body %>
    </div>

    <div>
      <%= f.label :rating %>
      <%= f.number_field :rating, min: 1, max: 10 %>
    </div>

    <%= f.submit "Submit Review" %>
  <% end %>

  <%= link_to "Back to Game", game_path(@game) %>
</div>